# You can find documentation for all the supported env variables at:
# https://docs.immich.app/install/environment-variables

# The location where your uploaded files are stored
UPLOAD_LOCATION=/data/photos

# The location where your database files are stored (network shares are not supported for the database)
DB_DATA_LOCATION=./postgres

# Timezone identifier
TZ=America/New_York

# Immich release version (e.g., release or pinned like v1.125.0)
IMMICH_VERSION=release

# Postgres Database Settings
DB_PASSWORD=your_secure_postgres_password_here
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
