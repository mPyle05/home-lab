# =============================================================================
# Servarr Stack Configuration (.env)
# Adapted from TechHutTV/homelab: https://github.com/TechHutTV/homelab
# =============================================================================

# General UID/GID and Timezone
# Run 'id $USER' on host to find your PUID and PGID
TZ=America/New_York
PUID=1000
PGID=1000

# Root Media/Data Mount Point (stores /data/torrents, /data/media, etc.)
DATA_DIR=/data

# -----------------------------------------------------------------------------
# Gluetun VPN Settings
# See Gluetun documentation for provider-specific settings:
# https://github.com/qdm12/gluetun-wiki
# -----------------------------------------------------------------------------
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard

# WireGuard Credentials
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here
# Optional WireGuard settings (required by some providers):
# WIREGUARD_PUBLIC_KEY=your_wireguard_public_key_here
# WIREGUARD_PRESHARED_KEY=your_preshared_key_here
# WIREGUARD_ADDRESSES=10.2.0.2/32

# Port Forwarding (if supported/required by your VPN provider, e.g. AirVPN, ProtonVPN)
# FIREWALL_VPN_INPUT_PORTS=your_forwarded_port_here

# Server Location (comma-separated list without spaces, e.g. "United States")
SERVER_COUNTRIES=United States
# SERVER_CITIES=New York

# DNS Configuration
DNS_UPSTREAM_RESOLVER_TYPE=plain
DNS_UPSTREAM_PLAIN_ADDRESSES=1.1.1.1:53

# Initial VPN Healthcheck Duration
HEALTH_VPN_DURATION_INITIAL=120s

# Gluetun HTTP Control Server API Key
GLUETUN_API_KEY=your_gluetun_api_key_here

# -----------------------------------------------------------------------------
# Static IPs for services on servarrnetwork (Subnet: 172.39.0.0/24)
# -----------------------------------------------------------------------------
SET_IP_GLUETUN=172.39.0.2
SET_IP_SONARR=172.39.0.3
SET_IP_RADARR=172.39.0.4
SET_IP_LIDARR=172.39.0.5
SET_IP_BAZARR=172.39.0.6
SET_IP_SEERR=172.39.0.7
SET_IP_JELLYSTAT_DB=172.39.0.8
SET_IP_JELLYSTAT=172.39.0.9
SET_IP_CHAPTARR=172.39.0.11

# Optional Jellystat Configuration (if enabled)
# JELLYSTAT_POSTGRES_USER=postgres
# JELLYSTAT_POSTGRES_PASSWORD=changeme_secure_password
# JELLYSTAT_JWT_SECRET=changeme_jwt_secret
